---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {% assign published_pages = site.pages | where_exp: "item", "item.sitemap != false" %}
  {% for item in published_pages %}
    {% if item.url %}
      <url>
        <loc>{{ item.url | absolute_url | xml_escape }}</loc>
        {% assign item_language = item.lang | default: "de" %}
        {% if item_language == "en" %}
          {% assign german_url = item.translation_url %}
        {% else %}
          {% assign german_url = item.url %}
        {% endif %}
        <xhtml:link
          rel="alternate"
          hreflang="{{ item_language }}"
          href="{{ item.url | absolute_url | xml_escape }}" />
        {% if item.translation_url %}
          <xhtml:link
            rel="alternate"
            hreflang="{% if item_language == 'en' %}de{% else %}en{% endif %}"
            href="{{ item.translation_url | absolute_url | xml_escape }}" />
          <xhtml:link
            rel="alternate"
            hreflang="x-default"
            href="{{ german_url | absolute_url | xml_escape }}" />
        {% endif %}
      </url>
    {% endif %}
  {% endfor %}
</urlset>
